# Credentials for a THROWAWAY Supabase Auth user, used only by the Playwright
# suite (e2e/authenticated/*). Copy this file to .env.test.local and fill it in;
# .env.test.local is gitignored and must never hold a real person's password.
#
# Create the user in the Supabase dashboard: Authentication -> Users -> Add user
# (enable "Auto Confirm User" so no email round trip is needed). It needs no
# special role — every authenticated user can already edit anything.
#
# Without these, `npx playwright test` still runs the public specs and skips the
# authenticated ones rather than failing.
E2E_EMAIL=
E2E_PASSWORD=
