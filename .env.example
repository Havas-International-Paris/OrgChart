VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only (no VITE_ prefix — must never ship to the client bundle).
# Used by api/chat.ts for the in-app AI chat. Free key from Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key

# Optional — if set, the chat uses Claude (Anthropic API, console.anthropic.com)
# instead of Gemini. Not the same as a claude.ai subscription; billed per token.
# Useful when Gemini's free tier is temporarily overloaded. See
# api/_lib/chatHandler.ts's resolveProvider() for the fallback order.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional — free key from build.nvidia.com, NVIDIA's OpenAI-compatible NIM
# API. Backs TWO providers: Nemotron and GLM-5.2 (Zhipu/Z.ai) — NVIDIA hosts
# both as free models under the same endpoint/key, no OpenRouter needed.
NVIDIA_API_KEY=your-nvidia-api-key

# Optional — pin the active provider explicitly instead of relying on
# resolveProvider()'s auto-detect order (anthropic > nemotron > glm > gemini,
# whichever key is present first). One of: anthropic | nemotron | glm | gemini.
LLM_PROVIDER=
